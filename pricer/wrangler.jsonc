
{
  "name": "tosbi-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public"
  },

  "vars": {
    "RPC_URL": "https://soroban-testnet.stellar.org",
    "NETWORK_PASSPHRASE": "Test SDF Network ; September 2015",
    "VAULT_ID": "CAZXBVORB2QN7V2FHYJFALYDRLBWZGUQDW2GSF3IKGYWFMEVVMZDS4PG",
    "ASSET_CODE": "tUSDC",
    "ASSET_ISSUER": "GCYYOX6T6DSACBQRPFR57HPLCUSRHSBD5QSQ3PWUCEOQ5OVKXPGBATME",

    "PERPDEX_ID": "REPLACE_WITH_DEPLOYED_PERPDEX_ID"
  },

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  "triggers": {
    "crons": [
      "* * * * *",
      "0 0 * * *"
    ]
  }
}
