@@ -0,0 +1,51 @@
+// Settles protections on time. Anyone may call settle / settle_early; the keeper just makes sure
+// someone does. Runs every minute from the Worker's cron trigger.
+
+/** The vault `protection(id)` result after `scValToNative`. */
+export interface KeptProtection {
+  status: number;
+  t_expire: bigint;
+  perpdex: string;
+  position_id: Uint8Array;
+  qty: bigint;
+}
+
+export interface KeeperDeps {
+  now: () => number;
+  nextId: () => Promise<number>;
+  /** First id that may still be active; everything below it is settled. */
+  cursor: { get: () => Promise<number>; set: (id: number) => Promise<void> };
+  protection: (id: number) => Promise<KeptProtection | undefined>;
+  position: (perpdex: string, id: Uint8Array) => Promise<{ status: number; size: bigint } | undefined>;
+  call: (method: "settle" | "settle_early", id: number) => Promise<string>;
+  log: (msg: string) => void;
+}
+
+// ponytail: polls every active protection each minute; switch to PositionClosed events when
+// active protections number in the hundreds.
+export async function runKeeper(d: KeeperDeps): Promise<void> {
+  const [start, next] = await Promise.all([d.cursor.get(), d.nextId()]);
+  let first = start;
+  let prefixSettled = true;
+  for (let id = start; id < next; id++) {
+    const p = await d.protection(id);
+    if (!p || p.status !== 0) {
+      if (prefixSettled) first = id + 1;
+      continue;
+    }
+    prefixSettled = false;
+    try {
+      if (d.now() >= Number(p.t_expire)) {
+        d.log(`#${id} settle: ${await d.call("settle", id)}`);
+        continue;
+      }
+      const pos = await d.position(p.perpdex, p.position_id);
+      if (pos && (pos.status !== 0 || pos.size < p.qty)) {
+        d.log(`#${id} settle_early: ${await d.call("settle_early", id)}`);
+      }
+    } catch (e) {
+      d.log(`#${id} failed: ${(e as Error).message}`);
+    }
+  }
+  if (first !== start) await d.cursor.set(first);
+}
