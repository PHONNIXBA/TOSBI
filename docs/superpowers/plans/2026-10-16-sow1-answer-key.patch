+# Recalibrates the vol tables every 4 hours (spec §3.3), publishes them to the Worker's KV, and
+# records their hash on-chain. Needs repo variable VAULT_ID and secrets OPERATOR_SECRET,
+# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID.
+name: Recalibrate vol tables
+on:
+  schedule:
+    - cron: "0 */4 * * *"
+  workflow_dispatch:
+jobs:
+  recalibrate:
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: pricer
+    env:
+      RPC_URL: https://soroban-testnet.stellar.org
+      NETWORK_PASSPHRASE: "Test SDF Network ; September 2015"
+      VAULT_ID: ${{ vars.VAULT_ID }}
+      OPERATOR_SECRET: ${{ secrets.OPERATOR_SECRET }}
+      CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+      CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+      - run: npm ci
+      - run: for a in XLM BTC ETH; do npm run calibrate -- "$a"; done
+      - run: node scripts/publish-vol.ts
+      - run: npx wrangler kv key put vol-tables --path vol-bundle.json --binding KV --remote
+      - run: node scripts/publish-vol.ts --post
