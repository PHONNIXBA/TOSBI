+//! Roles, pause and timelocked changes (spec §7.9). `admin` is a Stellar multisig account holding
+//! TOSBI and PerpDEX signers; its signature thresholds are enforced by the network, not here.
+
+use soroban_sdk::{
+    contractevent, contractimpl, contracttype, Address, BytesN, ContractExecutable, Env, Symbol,
+};
+
+use crate::{
+    config, flag, set_persistent, Error, Key, Params, ProtectionContract, ProtectionContractArgs,
+    ProtectionContractClient,
+};
+
+#[contracttype]
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum Change {
+    Params(Params),
+    Pricer(BytesN<32>),
+    Oracle(Address),
+    Treasury(Address),
+    Asset(Symbol, bool),
+    Perpdex(Address, bool),
+    Upgrade(BytesN<32>),
+}
+
+#[contracttype]
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct PendingChange {
+    pub change: Change,
+    pub eta: u64,
+}
+
+#[contractevent]
+pub struct ChangeProposed {
+    #[topic]
+    pub id: u64,
+    pub eta: u64,
+}
+
+#[contractevent]
+pub struct ChangeExecuted {
+    #[topic]
+    pub id: u64,
+}
+
+#[contractevent]
+pub struct ChangeCancelled {
+    #[topic]
+    pub id: u64,
+}
+
+#[contractevent]
+pub struct PauseSet {
+    pub paused: bool,
+}
+
+#[contractevent]
+pub struct VolHashSet {
+    pub hash: BytesN<32>,
+}
+
+#[contractimpl]
+impl ProtectionContract {
+    pub fn propose(env: Env, change: Change) -> u64 {
+        let cfg = config(&env);
+        cfg.admin.require_auth();
+        let id: u64 = env.storage().instance().get(&Key::NextChange).unwrap_or(0);
+        env.storage().instance().set(&Key::NextChange, &(id + 1));
+        let eta = env.ledger().timestamp() + cfg.params.timelock;
+        set_persistent(&env, &Key::Change(id), &PendingChange { change, eta });
+        ChangeProposed { id, eta }.publish(&env);
+        id
+    }
+
+    pub fn execute(env: Env, id: u64) -> Result<(), Error> {
+        let mut cfg = config(&env);
+        cfg.admin.require_auth();
+        let key = Key::Change(id);
+        let pending: PendingChange = env
+            .storage()
+            .persistent()
+            .get(&key)
+            .ok_or(Error::NoChange)?;
+        if env.ledger().timestamp() < pending.eta {
+            return Err(Error::Timelocked);
+        }
+        env.storage().persistent().remove(&key);
+        let s = env.storage().instance();
+        match pending.change {
+            Change::Params(p) => cfg.params = p,
+            Change::Pricer(k) => cfg.pricer = k,
+            Change::Oracle(a) => cfg.oracle = a,
+            Change::Treasury(a) => cfg.treasury = a,
+            Change::Asset(a, on) => s.set(&Key::Asset(a), &on),
+            Change::Perpdex(a, on) => s.set(&Key::Perpdex(a), &on),
+            Change::Upgrade(hash) => env
+                .deployer()
+                .update_current_contract(ContractExecutable::Wasm(hash)),
+        }
