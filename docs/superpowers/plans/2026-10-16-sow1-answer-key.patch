+// hash on-chain (set_vol_hash, signed by OPERATOR_SECRET) so partners can check /api/vol-tables.
+// Upload vol-bundle.json to the Worker's KV (key "vol-tables") before posting the hash.
+import { createHash } from "node:crypto";
+import { readFileSync, writeFileSync } from "node:fs";
+import { nativeToScVal } from "@stellar/stellar-sdk";
+import { invokeAs } from "../src/chain.ts";
+import { ASSETS } from "../src/service.ts";
+
+const file = (name: string) => new URL(`../${name}`, import.meta.url);
+const tables = Object.fromEntries(ASSETS.map((a) => [a, JSON.parse(readFileSync(file(`vol-tables/${a}.json`), "utf8"))]));
+const bundle = JSON.stringify(tables);
+writeFileSync(file("vol-bundle.json"), bundle);
+const hash = createHash("sha256").update(bundle).digest();
+console.log(hash.toString("hex"));
+
+if (process.argv.includes("--post")) {
+  const { RPC_URL, NETWORK_PASSPHRASE, VAULT_ID, OPERATOR_SECRET } = process.env;
+  if (!RPC_URL || !NETWORK_PASSPHRASE || !VAULT_ID || !OPERATOR_SECRET) {
+    throw new Error("--post needs RPC_URL, NETWORK_PASSPHRASE, VAULT_ID and OPERATOR_SECRET");
+  }
+  const n = { rpcUrl: RPC_URL, passphrase: NETWORK_PASSPHRASE };
+  const r = await invokeAs(n, OPERATOR_SECRET, VAULT_ID, "set_vol_hash", [nativeToScVal(hash)]);
+  console.log(`set_vol_hash ${r.status} ${r.hash}`);
+  if (r.status !== "SUCCESS") process.exit(1);
+}
