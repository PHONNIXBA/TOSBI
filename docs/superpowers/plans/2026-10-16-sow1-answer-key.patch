+++ b/scripts/admin.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+# Calls an admin-only vault function, signed by both admin signers (TOSBI + PerpDEX).
+# Usage: scripts/admin.sh <local|testnet> <function> [args...]
+#   scripts/admin.sh testnet propose --change '{"Perpdex":["C...",false]}'
+#   scripts/admin.sh testnet execute --id 0
+#   scripts/admin.sh testnet unpause
+set -euo pipefail
+NET=$1; shift
+ROOT=$(cd "$(dirname "$0")/.." && pwd)
+VAULT_ID=$(grep '^VAULT_ID=' "$ROOT/pricer/.dev.vars" | cut -d= -f2)
+ADMIN_ID=$(grep '^ADMIN_ID=' "$ROOT/pricer/.dev.vars" | cut -d= -f2)
+stellar contract invoke --id "$VAULT_ID" --source-account "$ADMIN_ID" --network "$NET" --build-only -- "$@" \
+  | stellar tx simulate --source-account "$ADMIN_ID" --network "$NET" \
+  | stellar tx sign --sign-with-key tosbi-signer-tosbi --network "$NET" \
+  | stellar tx sign --sign-with-key tosbi-signer-pdx --network "$NET" \
+  | stellar tx send --network "$NET"
