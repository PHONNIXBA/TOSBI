@@ -0,0 +1,52 @@
+// Market data for the vol-shock pause and the liquidity cap. Coinbase and Kraken both answer
+// from Cloudflare; Binance does not.
+import { YEAR_SECS } from "./pricing.ts";
+
+const COINBASE = "https://api.exchange.coinbase.com/products";
+const KRAKEN_PAIRS: Record<string, string> = { XLM: "XLMUSD", BTC: "XBTUSD", ETH: "ETHUSD" };
+const HEADERS = { headers: { "user-agent": "tosbi-pricer" } };
+/** Price move the liquidity cap prices against (spec R_ref). */
+const MOVE = 0.25;
+
+/** Annualized volatility of log returns between consecutive closes `stepSecs` apart. */
+export function realizedVol(closes: number[], stepSecs: number): number {
+  const r = closes.slice(1).map((c, i) => Math.log(c / closes[i]));
+  const mean = r.reduce((a, b) => a + b, 0) / r.length;
+  const variance = r.reduce((a, b) => a + (b - mean) ** 2, 0) / (r.length - 1);
+  return Math.sqrt(variance * (YEAR_SECS / stepSecs));
+}
+
+/** USD resting from the best level out to `move` away. `levels` are [price, size], best first. */
+export function bookDepth(levels: [number, number][], move: number, side: "bids" | "asks"): number {
+  if (levels.length === 0) return 0;
+  const limit = side === "bids" ? levels[0][0] * (1 - move) : levels[0][0] * (1 + move);
+  let usd = 0;
+  for (const [p, q] of levels) {
+    if (side === "bids" ? p < limit : p > limit) break;
+    usd += p * q;
+  }
+  return usd;
+}
+
+/** The last `count` + 1 closes, oldest first. */
+export async function recentCloses(asset: string, stepSecs: number, count: number): Promise<number[]> {
+  const res = await fetch(`${COINBASE}/${asset}-USD/candles?granularity=${stepSecs}`, HEADERS);
+  if (!res.ok) throw new Error(`coinbase candles ${asset}: HTTP ${res.status}`);
+  const rows = (await res.json()) as number[][];
+  return rows.slice(0, count + 1).reverse().map((row) => row[4]);
+}
+
+type Book = { bids: string[][]; asks: string[][] };
+const levels = (rows: string[][]) => rows.map(([p, q]) => [Number(p), Number(q)] as [number, number]);
+
+/** USDC needed to move `asset` 25% on Coinbase + Kraken, on whichever side is thinner. */
+export async function depthUsd(asset: string): Promise<number> {
+  const [cb, kr] = await Promise.all([
+    fetch(`${COINBASE}/${asset}-USD/book?level=2`, HEADERS).then((r) => r.json() as Promise<Book>),
+    fetch(`https://api.kraken.com/0/public/Depth?pair=${KRAKEN_PAIRS[asset]}&count=500`)
+      .then((r) => r.json() as Promise<{ result: Record<string, Book> }>)
+      .then((j) => Object.values(j.result)[0]),
+  ]);
+  const side = (s: "bids" | "asks") => bookDepth(levels(cb[s]), MOVE, s) + bookDepth(levels(kr[s]), MOVE, s);
+  return Math.min(side("bids"), side("asks"));
+}
