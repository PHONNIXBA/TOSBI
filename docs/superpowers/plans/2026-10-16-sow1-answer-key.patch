new file mode 100644
index 0000000..696a3ac
--- /dev/null
+++ b/contracts/protection/src/oracle.rs
@@ -0,0 +1,96 @@
+//! SEP-40 oracle reads (Reflector). All prices leave this module as USDC per unit with 7 decimals.
+
+use soroban_sdk::{contractclient, contracttype, Address, Env, Symbol};
+
+use crate::{Params, BPS};
+
+#[contracttype]
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum Asset {
+    Stellar(Address),
+    Other(Symbol),
+}
+
+#[contracttype]
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct PriceData {
+    pub price: i128,
+    pub timestamp: u64,
+}
+
+#[allow(dead_code)]
+#[contractclient(name = "OracleClient")]
+pub trait Sep40 {
+    fn decimals(env: Env) -> u32;
+    fn resolution(env: Env) -> u32;
+    fn price(env: Env, asset: Asset, timestamp: u64) -> Option<PriceData>;
+    fn lastprice(env: Env, asset: Asset) -> Option<PriceData>;
+}
+
+/// The single place oracle decimals are converted.
+pub fn to_7(price: i128, decimals: u32) -> i128 {
+    if decimals >= 7 {
+        price / 10i128.pow(decimals - 7)
+    } else {
+        price * 10i128.pow(7 - decimals)
+    }
+}
+
+/// Average price over the `window` seconds ending at `end`, read record by record.
+/// A record more than `record_cap_bps` away from the last accepted one (starting from the record
+/// just before the window) is skipped. None when the record at the end of the window is missing:
+/// not published yet, or older than the oracle keeps.
+pub fn twap(
+    env: &Env,
+    oracle: &Address,
+    p: &Params,
+    asset: &Symbol,
+    end: u64,
+    window: u64,
+) -> Option<i128> {
+    let c = OracleClient::new(env, oracle);
+    let res = c.resolution() as u64;
+    let decimals = c.decimals();
+    let a = Asset::Other(asset.clone());
+    let at = |ts: u64| {
+        c.price(&a, &ts)
+            .filter(|r| r.timestamp == ts)
+            .map(|r| to_7(r.price, decimals))
+    };
+    let last = end / res * res;
+    let n = window.div_ceil(res).max(1);
+    at(last)?;
+    let mut prev = at(last.saturating_sub(n * res));
+    let (mut sum, mut count) = (0i128, 0i128);
+    for k in (0..n).rev() {
+        let Some(px) = at(last - k * res) else {
+            continue;
+        };
+        if let Some(pr) = prev {
+            if (px - pr).abs() * BPS > pr * p.record_cap_bps as i128 {
+                continue;
+            }
+        }
+        sum += px;
+        count += 1;
+        prev = Some(px);
+    }
+    if count == 0 {
+        None
+    } else {
+        Some(sum / count)
+    }
+}
+
+/// The record at or before `ts`.
+pub fn price_at(env: &Env, oracle: &Address, asset: &Symbol, ts: u64) -> Option<i128> {
+    let c = OracleClient::new(env, oracle);
+    c.price(&Asset::Other(asset.clone()), &ts)
+        .map(|r| to_7(r.price, c.decimals()))
+}
+
+pub fn last(env: &Env, oracle: &Address, asset: &Symbol) -> Option<i128> {
+    let c = OracleClient::new(env, oracle);
+    c.lastprice(&Asset::Other(asset.clone()))
+        .map(|r| to_7(r.price, c.decimals()))
+}
